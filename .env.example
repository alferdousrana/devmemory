# DevMemory — Firebase web app configuration
# Copy this file to `.env` (never commit `.env`) and fill in the values from
# Firebase Console → Project settings → General → Your apps → SDK setup and configuration → Config.
#
# These values identify your Firebase project to the browser. They are NOT secrets:
# every Firebase web app ships them to the client. Your data is protected by
# Firebase Authentication + firestore.rules + storage.rules, not by hiding these.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional — Google Analytics for Firebase. Analytics only runs if the user opts in
# under Settings → Privacy. Leave empty to disable analytics completely.
VITE_FIREBASE_MEASUREMENT_ID=

# Optional — Firebase App Check with reCAPTCHA v3. Leave empty to disable.
VITE_FIREBASE_APPCHECK_SITE_KEY=

# Optional — set to "true" to use the local Firebase Emulator Suite during development.
VITE_USE_FIREBASE_EMULATORS=false
